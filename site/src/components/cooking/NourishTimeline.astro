---
// Schematic of Nourishment over time (NourishmentEffect#applyEffectTick): hunger and saturation frozen, except that
// saturation may be spent on natural healing while hurt; once it is gone, hunger stays full and healing goes on.
// The chart only carries numbers; the phase names are an HTML legend so the pixel font stays at 20px.
import { url } from '../../lib/data';
const W = 600;
const H = 300;
const L = 130;
const R = 8;
const phases = [
	{ x0: 0, x1: 0.28, t: 'Full health', s: 'nothing drains' },
	{ x0: 0.28, x1: 0.55, t: 'Hurt', s: 'saturation is spent on healing' },
	{ x0: 0.55, x1: 0.82, t: 'Saturation used up', s: 'hunger stays full, healing goes on' },
	{ x0: 0.82, x1: 1, t: 'Effect ends', s: 'hunger drains as normal' },
];
const X = (f: number) => L + f * (W - L - R);
const lanes = [
	{ y: 110, label: 'Health', icon: '/gui/mc/heart_full.png', cls: 'hp', d: [[0, 1], [0.28, 1], [0.3, 0.3], [0.55, 0.7], [0.82, 0.95], [1, 0.95]] },
	{ y: 195, label: 'Saturation', icon: null, cls: 'sat', d: [[0, 0.6], [0.28, 0.6], [0.55, 0], [1, 0]] },
	{ y: 280, label: 'Hunger', icon: '/gui/mc/food_full.png', cls: 'food', d: [[0, 1], [0.82, 1], [1, 0.6]] },
];
const lane = 56;
---
<figure class="fd-ntime not-content">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Nourishment over time: hunger stays full; saturation is only spent on healing while hurt">
		{phases.map((p, i) => (
			<g>
				{i % 2 === 1 && <rect x={X(p.x0)} y="0" width={X(p.x1) - X(p.x0)} height={H} class="band" />}
				<text x={(X(p.x0) + X(p.x1)) / 2} y="26" class="ph" text-anchor="middle">{i + 1}</text>
			</g>
		))}
		{lanes.map((ln) => (
			<g>
				<line x1={L} y1={ln.y} x2={W - R} y2={ln.y} class="base" />
				{ln.icon && <image href={url(ln.icon)} x="0" y={ln.y - 38} width="18" height="18" class="px" />}
				<text x={ln.icon ? 24 : 0} y={ln.y - 22} class="lb">{ln.label}</text>
				<path d={ln.d.map(([f, v], i) => `${i ? 'L' : 'M'}${X(f).toFixed(1)} ${(ln.y - v * (lane - 10)).toFixed(1)}`).join(' ')} class:list={['ln', ln.cls]} />
			</g>
		))}
	</svg>
	<ol class="legend">
		{phases.map((p) => <li><b>{p.t}</b>: {p.s}</li>)}
	</ol>
	<figcaption>A sketch of the rule, not to scale.</figcaption>
</figure>
<style>
	.fd-ntime {
		margin: 30px 0;
		max-width: 600px;
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
		background: var(--fd-surface);
		border: 3px solid var(--fd-frame);
		box-shadow: 4px 4px 0 #000;
	}
	.band {
		fill: var(--fd-surface-2);
	}
	.base {
		stroke: var(--fd-border);
		stroke-width: 2;
	}
	.ln {
		fill: none;
		stroke-width: 4;
	}
	.hp {
		stroke: var(--sl-color-text-accent);
	}
	.sat {
		stroke: var(--fd-gold);
	}
	.food {
		stroke: var(--sl-color-white);
	}
	.ph {
		fill: var(--fd-heading-ink);
		font: 400 20px var(--fd-font-display);
	}
	.lb {
		fill: var(--sl-color-gray-2);
		font: 400 20px var(--fd-font-mono);
	}
	.px {
		image-rendering: pixelated;
	}
	.legend {
		margin: 12px 0 0;
		padding-left: 30px;
		font-size: 20px;
		line-height: 30px;
		color: var(--sl-color-gray-2);
	}
	.legend li {
		margin: 0;
	}
	figcaption {
		font-size: 20px;
		color: var(--sl-color-gray-3);
	}
</style>
