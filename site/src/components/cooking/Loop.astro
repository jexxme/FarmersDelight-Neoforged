---
// The mod's loop at a glance: grow, cut, cook, feast. Four canvas signs with a real render, what happens there and one
// number from the data, each linking to its page. On wide screens a row with arrows, then two by two, then (phones)
// one sign per row with the picture on the left.
import { meta, recipes, tags, blocks, renderOf, iconOf, url, seconds } from '../../lib/data';
import { pot } from '../../data/code/cooking';

const cooking = recipes.filter((r) => r.loaded && r.type === 'farmersdelight:cooking');
const times = cooking.map((r) => (r as { cookingtime?: number }).cookingtime ?? pot.defaultCookTime.value);
const cutting = recipes.filter((r) => r.loaded && r.type === 'farmersdelight:cutting');
const withKnife = cutting.filter((r) => (r as { tool?: { tag?: string } }).tool?.tag === 'c:tools/knife').length;
const wild = tags.resolved.block['farmersdelight:wild_crops'] ?? [];
const feasts = tags.resolved.block['farmersdelight:feasts'] ?? [];
const servings = feasts.map((id) => Math.max(...blocks[id].properties.servings.map(Number)));
const range = (a: number, b: number, unit = '') => (a === b ? `${a}${unit}` : `${a} to ${b}${unit}`);
const secs = (t: number) => seconds(t).replace(' s', '');

const steps = [
	{ n: 'Grow', href: '/mechanics/crops/', img: renderOf('scenes/garden'), what: 'Cabbages, tomatoes, onions and rice', fact: `${wild.length} wild crops to find first` },
	{ n: 'Cut', href: '/mechanics/cutting-board/', img: renderOf('blocks/cutting_board'), knife: iconOf('farmersdelight:iron_knife')?.src, what: 'Meat, crops and logs into parts', fact: `${cutting.length} recipes, ${withKnife} with a knife` },
	{ n: 'Cook', href: '/mechanics/cooking-pot/', img: renderOf('scenes/pot-on-stove'), what: `Up to ${pot.maxIngredients.value} ingredients, ${meta.counts.cooking} recipes`, fact: `${range(secs(Math.min(...times)), secs(Math.max(...times)), ' s')} over heat` },
	{ n: 'Feast', href: '/mechanics/feasts/', img: renderOf('scenes/feast-table'), what: `${feasts.length} feasts to set out and share`, fact: `${range(Math.min(...servings), Math.max(...servings))} servings each` },
];
---
<ol class="fd-loop not-content" aria-label="How it works: grow, cut, cook, feast">
	{steps.map((s, i) => (
		<li>
			<a href={url(s.href)} class="card fd-sign">
				<span class="n">{i + 1}. {s.n}</span>
				<span class="pic">
					{s.img && <img src={s.img} alt="" width="112" height="112" loading="lazy" />}
					{s.knife && <img class="knife" src={s.knife} alt="" width="32" height="32" loading="lazy" />}
				</span>
				<span class="what">{s.what}</span>
				<span class="fact">{s.fact}</span>
			</a>
		</li>
	))}
</ol>
<style>
	.fd-loop {
		list-style: none;
		padding: 0;
		margin: 28px 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}
	li {
		margin: 0 !important;
		position: relative;
	}
	/* the arrow from one sign to the next */
	li + li::before {
		content: '>';
		position: absolute;
		left: -16px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--sl-color-text-accent);
	}
	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		height: 100%;
		box-sizing: border-box;
		padding: 6px 6px 4px;
		text-align: center;
		text-decoration: none;
		box-shadow: 6px 6px 0 rgb(0 0 0 / 0.35);
		transition: transform 0.15s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.card:hover,
	.card:focus-visible {
		transform: translateY(-4px);
		outline: none;
	}
	.card:focus-visible {
		box-shadow: 6px 6px 0 rgb(0 0 0 / 0.35), 0 0 0 2px var(--sl-color-text-accent);
	}
	.n {
		color: #6e3214;
		text-shadow: 2px 0 0 currentColor;
		letter-spacing: 2px;
		padding-bottom: 4px;
		border-bottom: 2px dashed #b18e65;
		align-self: stretch;
	}
	.pic {
		position: relative;
		width: 112px;
		height: 112px;
		margin: 4px 0;
	}
	.pic img {
		display: block;
		width: 112px;
		height: 112px;
		transition: transform 0.15s;
	}
	/* the knife lies on the board, so the Cut sign shows the tool too */
	.pic .knife {
		position: absolute;
		left: 44px;
		top: 34px;
		width: 32px;
		height: 32px;
		image-rendering: pixelated;
		transform: rotate(-10deg);
	}
	.card:hover .pic img:first-child,
	.card:focus-visible .pic img:first-child {
		transform: scale(1.06);
	}
	.what {
		color: #483015;
		line-height: 24px;
	}
	.fact {
		color: #785836;
		line-height: 24px;
		margin-top: auto;
		padding-top: 4px;
	}
	@media (prefers-reduced-motion: reduce) {
		.card,
		.pic img {
			transition: none;
		}
		.card:hover,
		.card:focus-visible {
			transform: none;
		}
	}
	@media (max-width: 50rem) {
		.fd-loop {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		li:nth-child(3)::before {
			display: none;
		}
	}
	/* Phones: one column, each sign a row (picture left, words right) so the four steps stay short */
	@media (max-width: 30rem) {
		.fd-loop {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		li + li::before {
			display: none;
		}
		.card {
			display: grid;
			grid-template-columns: 80px 1fr;
			grid-template-areas: 'pic n' 'pic what' 'pic fact';
			align-items: center;
			column-gap: 12px;
			text-align: left;
		}
		.n {
			grid-area: n;
		}
		.pic {
			grid-area: pic;
			width: 80px;
			height: 80px;
		}
		.pic img {
			width: 80px;
			height: 80px;
		}
		.pic .knife {
			left: 30px;
			top: 24px;
			width: 32px;
			height: 32px;
		}
		.what {
			grid-area: what;
		}
		.fact {
			grid-area: fact;
		}
	}
</style>
