---
// Home page as a Minecraft title screen (panorama, logo, splash text, stone buttons), followed by the chapters on
// canvas signs and the whole mod in a creative-inventory panel with one tab per category.
import Slot from './mc/Slot.astro';
import { meta, url, itemList, CATEGORIES, iconOf } from '../lib/data';

const cats = Object.entries(CATEGORIES)
	.map(([key, v]) => ({ key, ...v, items: itemList.filter((i) => i.category === key) }))
	.filter((c) => c.items.length);
const tabIcon: Record<string, string> = {
	workstations: 'farmersdelight:cooking_pot', tools: 'farmersdelight:iron_knife', crops: 'farmersdelight:cabbage', farming: 'farmersdelight:rich_soil',
	ingredients: 'farmersdelight:wheat_dough', meals: 'farmersdelight:beef_stew', feasts: 'farmersdelight:roast_chicken_block', snacks: 'farmersdelight:hamburger',
	sweets: 'farmersdelight:honey_cookie', pies: 'farmersdelight:apple_pie', drinks: 'farmersdelight:hot_cocoa', storage: 'farmersdelight:oak_cabinet',
	decoration: 'farmersdelight:canvas_sign', materials: 'farmersdelight:straw',
};
const foods = itemList.filter((i) => i.food).length;
const oldest = meta.versions[meta.versions.length - 1].gameVersions.split(',')[0];
const newest = meta.versions[0].minecraft;
// Splash texts, all true for this release
const splashes = [
	`${meta.counts.recipes} recipes!`,
	`${meta.counts.cooking} meals in one pot!`,
	`${foods} things to eat!`,
	`Minecraft ${oldest} to ${newest}!`,
	'Now with REI!',
	'Knives for ham!',
	'Rich Soil!',
];
const chapters = [
	{ title: 'Cooking', icon: 'farmersdelight:cooking_pot', pages: [['Cooking Pot', 'mechanics/cooking-pot'], ['Heat sources', 'mechanics/heat-sources'], ['Stove', 'mechanics/stove'], ['Skillet', 'mechanics/skillet'], ['Cutting Board', 'mechanics/cutting-board'], ['Feasts', 'mechanics/feasts'], ['Pies & cakes', 'mechanics/pies'], ['Drinks', 'mechanics/drinks']] },
	{ title: 'Farming', icon: 'farmersdelight:cabbage', pages: [['Crops', 'mechanics/crops'], ['Wild crops', 'mechanics/wild-crops'], ['Rich Soil', 'mechanics/rich-soil'], ['Organic Compost', 'mechanics/organic-compost'], ['Mushroom Colonies', 'mechanics/mushroom-colonies'], ['Straw & rope', 'mechanics/straw-and-rope']] },
	{ title: 'Tools & effects', icon: 'farmersdelight:diamond_knife', pages: [['Knives', 'mechanics/knives'], ['Nourishment', 'mechanics/effects'], ['Animal feed', 'mechanics/animal-feed']] },
	{ title: 'The world', icon: 'farmersdelight:oak_cabinet', pages: [['Storage & decoration', 'mechanics/storage-and-decoration'], ['Villagers', 'mechanics/villagers'], ['Loot', 'mechanics/loot']] },
	{ title: 'Reference', icon: 'farmersdelight:beef_stew', pages: [['Food tables', 'reference/food'], ['Recipe planner', 'reference/recipe-planner'], ['All recipes', 'reference/recipes'], ['Configuration', 'reference/config'], ['Advancements', 'reference/advancements']] },
	{ title: 'Pack makers', icon: 'farmersdelight:cutting_board', pages: [['Recipe formats', 'pack-makers/recipes'], ['Tags', 'pack-makers/tags'], ['Loot modifiers', 'pack-makers/loot-modifiers'], ['Worldgen', 'pack-makers/worldgen']] },
];
---
<div class="landing not-content">
	<section class="title-screen" style={`background-image:url(${url('/shots/hero.jpg')})`}>
		<div class="logo-wrap">
			<img class="logo" src={url('/ui/banner.png')} alt="Farmer's Delight Neoforged" width="536" height="136" />
			<span class="splash" data-splashes={JSON.stringify(splashes)}>{splashes[0]}</span>
		</div>
		<nav class="menu" aria-label="Start">
			<a class="mc-button wide" href={url('/getting-started/')}>Getting started</a>
			<a class="mc-button wide" href={url('/items/')}>All {meta.counts.items} items &amp; blocks</a>
			<div class="pair">
				<a class="mc-button" href="https://modrinth.com/mod/farmers-delight-neoforged">Modrinth</a>
				<a class="mc-button" href="https://www.curseforge.com/minecraft/mc-mods/farmers-delight-neoforged">CurseForge</a>
			</div>
		</nav>
		<p class="corner left">Farmer's Delight Neoforged {meta.modVersion}</p>
		<p class="corner right">Not an official Minecraft or vectorwing product</p>
	</section>

	<p class="intro">
		The guide to cooking, farming and feasting with Farmer's Delight on Minecraft {oldest} to {newest}. Every recipe, drop chance and food
		value here was read from the mod itself:{' '}<span class="hl">{meta.counts.items}</span> items,{' '}<span class="hl">{meta.counts.recipes}</span> recipes,{' '}
		<span class="hl">{meta.counts.cooking}</span> Cooking Pot meals and{' '}<span class="hl">{foods}</span> foods.
	</p>

	<section class="chapters">
		{chapters.map((c) => (
			<div class="chapter fd-sign">
				<h2>
					<img src={iconOf(c.icon)?.src} alt="" width="32" height="32" />
					{c.title}
				</h2>
				<ul>
					{c.pages.map(([label, slug]) => (
						<li>
							<a href={url(`/${slug}/`)}>{label}</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</section>

	<section class="pantry" aria-label="All items by category">
		<div class="tabs" role="tablist">
			{cats.map((c, i) => (
				<button type="button" role="tab" class="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`tab-${c.key}`} data-tab={c.key} title={c.label}>
					<img src={iconOf(tabIcon[c.key] ?? c.items[0].id)?.src} alt={c.label} width="32" height="32" />
				</button>
			))}
		</div>
		<div class="inv mc-panel" style="--s:2px">
			{cats.map((c, i) => (
				<div class="inv-page" id={`tab-${c.key}`} role="tabpanel" hidden={i !== 0}>
					<p class="inv-title">
						{c.label} <span>({c.items.length})</span>
						<a href={url(`/items/#${c.key}`)}>open list</a>
					</p>
					<div class="inv-grid">
						{c.items.map((it) => (
							<Slot id={it.id} scale={3} />
						))}
						{Array.from({ length: (9 - (c.items.length % 9)) % 9 + (c.items.length <= 9 ? 9 : 0) }).map(() => (
							<Slot scale={3} />
						))}
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="colophon">
		<p>
			<b>How these pages are made.</b> A test inside the game exports the real item stats, scripts read recipes, loot tables and tags
			from the mod's data, and a small renderer draws every icon and block from the mod's own models and textures. When the mod changes,
			the pages are rebuilt. <a href={url('/about/')}>More about this</a>
		</p>
	</section>
</div>

<script>
	// Pick a splash text, like the title screen does
	for (const el of document.querySelectorAll<HTMLElement>('.splash[data-splashes]')) {
		const list = JSON.parse(el.dataset.splashes!);
		el.textContent = list[Math.floor(Math.random() * list.length)];
	}
	// Creative-inventory tabs
	for (const tab of document.querySelectorAll<HTMLButtonElement>('.pantry .tab')) {
		tab.addEventListener('click', () => {
			for (const t of document.querySelectorAll<HTMLButtonElement>('.pantry .tab')) t.setAttribute('aria-selected', String(t === tab));
			for (const p of document.querySelectorAll<HTMLElement>('.pantry .inv-page')) p.hidden = p.id !== `tab-${tab.dataset.tab}`;
		});
	}
</script>

<style>
	:global(body:has(.landing) .content-panel:has(h1#_top)) {
		display: none;
	}
	.landing {
		padding-top: 1rem;
	}
	.title-screen {
		position: relative;
		min-height: 560px;
		background-size: cover;
		background-position: 50% 40%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 44px;
		padding: 60px 16px 70px;
		border: 4px solid #000;
		box-shadow: 6px 6px 0 #000;
	}
	.logo-wrap {
		position: relative;
	}
	.logo {
		display: block;
		width: min(536px, 84vw);
		height: auto;
		image-rendering: pixelated;
	}
	.splash {
		position: absolute;
		right: -40px;
		bottom: -8px;
		color: #ffff00;
		font-size: 20px;
		text-shadow: 2px 2px 0 #3f3f00;
		white-space: nowrap;
		transform: rotate(-20deg);
		animation: splash 0.5s ease-in-out infinite alternate;
		pointer-events: none;
	}
	@keyframes splash {
		from {
			transform: rotate(-20deg) scale(1);
		}
		to {
			transform: rotate(-20deg) scale(1.08);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.splash {
			animation: none;
		}
	}
	.menu {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: min(400px, 100%);
	}
	.menu .wide {
		width: 100%;
	}
	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin-top: 16px;
	}
	.corner {
		position: absolute;
		bottom: 6px;
		margin: 0;
		color: #fff;
		text-shadow: 2px 2px 0 #3f3f3f;
		font-size: 20px;
	}
	.corner.left {
		left: 10px;
	}
	.corner.right {
		right: 10px;
	}
	.intro {
		font-size: 20px;
		line-height: 30px;
		max-width: 48rem;
		margin: 48px 0 40px;
		color: var(--sl-color-gray-2);
	}
	.hl {
		color: var(--fd-gold);
	}
	.chapters {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px 24px;
	}
	.chapter {
		margin: 0;
	}
	.chapter h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 6px;
		font-size: 20px;
		font-weight: 400;
		color: #483015;
		text-shadow: 2px 0 0 currentColor;
		letter-spacing: 2px;
	}
	.chapter h2 img {
		image-rendering: pixelated;
	}
	.chapter ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.chapter li {
		margin: 0;
		line-height: 30px;
	}
	.chapter a {
		color: #6e3214;
		text-decoration: none;
	}
	.chapter a::before {
		content: '> ';
		color: #b18e65;
	}
	.chapter a:hover {
		color: #000;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.pantry {
		margin-top: 64px;
	}
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 2px;
		padding-left: 4px;
	}
	.tab {
		width: 56px;
		height: 52px;
		display: grid;
		place-items: center;
		background: #8b8b8b;
		border: 0;
		cursor: pointer;
		box-shadow: inset 2px 2px 0 #aaa, inset -2px 0 0 #555, 0 -2px 0 #000, 2px 0 0 #000, -2px 0 0 #000;
		margin-top: 6px;
	}
	.tab[aria-selected='true'] {
		background: #c6c6c6;
		height: 58px;
		margin-top: 0;
		box-shadow: inset 2px 2px 0 #fff, inset -2px 0 0 #555, 0 -2px 0 #000, 2px 0 0 #000, -2px 0 0 #000;
		position: relative;
		z-index: 1;
	}
	.tab img {
		image-rendering: pixelated;
	}
	.inv {
		display: block !important;
		width: fit-content;
		max-width: 100%;
		padding: 12px 16px 16px !important;
	}
	.inv-title {
		margin: 0 0 8px;
		color: #404040;
		font-size: 20px;
		display: flex;
		gap: 10px;
		align-items: baseline;
		flex-wrap: wrap;
	}
	.inv-title span {
		color: #707070;
	}
	.inv-title a {
		margin-left: auto;
		color: #404040;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.inv-grid {
		display: grid;
		grid-template-columns: repeat(9, 54px);
	}
	@media (max-width: 40rem) {
		.inv-grid {
			grid-template-columns: repeat(6, 54px);
		}
	}
	.colophon {
		margin-top: 56px;
		max-width: 48rem;
		color: var(--sl-color-gray-3);
	}
	.colophon a {
		color: var(--sl-color-text-accent);
	}
	@media (max-width: 60rem) {
		.chapters {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 40rem) {
		.chapters {
			grid-template-columns: 1fr;
		}
		.title-screen {
			min-height: 480px;
		}
		.corner.right {
			display: none;
		}
		.splash {
			right: 0;
		}
	}
</style>
