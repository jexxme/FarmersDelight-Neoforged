---
// Home page, laid out like the front of a cookbook: masthead, a plate, the contents, the pantry, a colophon.
import Slot from './mc/Slot.astro';
import { meta, url, itemList, CATEGORIES, renderOf } from '../lib/data';

const cats = Object.entries(CATEGORIES)
	.map(([key, v]) => ({ key, ...v, items: itemList.filter((i) => i.category === key) }))
	.filter((c) => c.items.length);
const foods = itemList.filter((i) => i.food).length;
const oldest = meta.versions[meta.versions.length - 1].gameVersions.split(',')[0];
const newest = meta.versions[0].minecraft;
const chapters = [
	{ title: 'Cooking', pages: [['Cooking Pot', 'mechanics/cooking-pot'], ['Heat sources', 'mechanics/heat-sources'], ['Stove', 'mechanics/stove'], ['Skillet', 'mechanics/skillet'], ['Cutting Board', 'mechanics/cutting-board'], ['Feasts', 'mechanics/feasts'], ['Pies & cakes', 'mechanics/pies'], ['Drinks', 'mechanics/drinks']] },
	{ title: 'Farming', pages: [['Crops', 'mechanics/crops'], ['Wild crops', 'mechanics/wild-crops'], ['Rich Soil', 'mechanics/rich-soil'], ['Organic Compost', 'mechanics/organic-compost'], ['Mushroom Colonies', 'mechanics/mushroom-colonies'], ['Straw & rope', 'mechanics/straw-and-rope']] },
	{ title: 'Tools & effects', pages: [['Knives', 'mechanics/knives'], ['Nourishment', 'mechanics/effects'], ['Animal feed', 'mechanics/animal-feed']] },
	{ title: 'The world', pages: [['Storage & decoration', 'mechanics/storage-and-decoration'], ['Villagers', 'mechanics/villagers'], ['Loot', 'mechanics/loot']] },
	{ title: 'Reference', pages: [['Food tables', 'reference/food'], ['Recipe planner', 'reference/recipe-planner'], ['All recipes', 'reference/recipes'], ['Configuration', 'reference/config'], ['Advancements', 'reference/advancements']] },
	{ title: 'For pack makers', pages: [['Recipe formats', 'pack-makers/recipes'], ['Tags', 'pack-makers/tags'], ['Loot modifiers', 'pack-makers/loot-modifiers'], ['Worldgen', 'pack-makers/worldgen']] },
];
---
<div class="landing not-content">
	<header class="mast">
		<p class="mast-meta">
			<span>farmersdelight</span><span>{meta.modVersion}</span><span>Minecraft {oldest} – {newest}</span><span>NeoForge</span>
		</p>
		<h1>Farmer's Delight Neoforged</h1>
		<div class="mast-cols">
			<p class="mast-lede">
				Everything about cooking, farming and feasting with Farmer's Delight on Minecraft 26.x. Each recipe, drop chance and food value on these pages was read from the mod itself, not copied from an old wiki.
			</p>
			<ul class="mast-links">
				<li><a href={url('/getting-started/')}>Getting started</a><span>install, first crops, first meal</span></li>
				<li><a href={url('/items/')}>All {meta.counts.items} items</a><span>every block and item, each with its page</span></li>
				<li><span class="pair"><a href="https://modrinth.com/mod/farmers-delight-neoforged">Modrinth</a> or <a href="https://www.curseforge.com/minecraft/mc-mods/farmers-delight-neoforged">CurseForge</a></span><span>download for your Minecraft version</span></li>
			</ul>
		</div>
	</header>

	<figure class="plate">
		<img src={url('/shots/hero.jpg')} alt="A farmhouse with a vegetable garden built with Farmer's Delight" fetchpriority="high" />
		<figcaption>A farmhouse and its vegetable garden, built with Farmer's Delight Neoforged.</figcaption>
	</figure>

	<p class="census">
		The mod adds <b>{meta.counts.items}</b> items and blocks and <b>{meta.counts.recipes}</b> recipes: <b>{meta.counts.cooking}</b> meals for the
		Cooking Pot, <b>{meta.counts.cutting}</b> ways to use the Cutting Board, and <b>{foods}</b> things to eat.
	</p>

	<section class="contents">
		<img src={renderOf('scenes/kitchen')} alt="" width="512" height="512" loading="lazy" />
		<div>
			<h2>Contents</h2>
			<ol>
				{chapters.map((c, i) => (
					<li>
						<span class="no">{String(i + 1).padStart(2, '0')}</span>
						<h3>{c.title}</h3>
						<p>
							{c.pages.map(([label, slug], j) => (
								<>
									{j > 0 && <span class="sep"> · </span>}
									<a href={url(`/${slug}/`)}>{label}</a>
								</>
							))}
						</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="pantry">
		<h2>The pantry</h2>
		<p class="pantry-note">Every item in the mod by kind. Hover for names, click for the item's page.</p>
		<table>
			<tbody>
				{cats.map((c) => (
					<tr>
						<th scope="row">
							<a href={url(`/items/#${c.key}`)}>{c.label}</a>
							<span>{c.items.length}</span>
						</th>
						<td>
							<div class="row">
								{c.items.map((i) => (
									<Slot id={i.id} scale={2} bare />
								))}
							</div>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</section>

	<section class="colophon">
		<p class="lbl">How these pages are made</p>
		<p>
			A test inside the game exports the real item stats: food values, effects, durability, stack sizes. Scripts then read recipes,
			loot tables and tags from the mod's data files, and a small renderer draws every icon and block from the mod's own models
			and textures. When the mod changes, the pages are rebuilt. <a href={url('/about/')}>More about this</a>.
		</p>
	</section>
</div>

<style>
	:global(body:has(.landing) .content-panel:has(h1#_top)) {
		display: none;
	}
	.landing {
		--rule: var(--fd-rule);
		padding-top: 1rem;
	}
	.mast {
		border-top: 4px solid var(--rule);
		padding-top: 0.75rem;
	}
	.mast-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		margin: 0;
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.mast h1 {
		font-family: var(--fd-font-display);
		font-weight: 400;
		font-size: clamp(2.6rem, 8.5vw, 6.2rem);
		line-height: 0.92;
		letter-spacing: -0.02em;
		margin: 1.25rem 0 1.5rem;
		color: var(--sl-color-white);
		max-width: 11ch;
	}
	.mast-cols {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: 2.5rem;
		border-top: 1px solid var(--rule);
		padding-top: 1rem;
	}
	.mast-lede {
		font-size: 1.2rem;
		line-height: 1.55;
		margin: 0;
		color: var(--sl-color-gray-1);
	}
	.mast-links {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.mast-links li {
		display: flex;
		flex-direction: column;
		padding: 0.45rem 0;
		border-bottom: 1px solid var(--fd-border);
	}
	.mast-links li:first-child {
		padding-top: 0;
	}
	.mast-links a {
		font-family: var(--fd-font-display);
		font-size: 1.25rem;
		color: var(--sl-color-accent);
		text-decoration: none;
	}
	.mast-links .pair {
		font-family: var(--fd-font-display);
		font-size: 1.25rem;
		color: var(--sl-color-gray-3);
	}
	.mast-links a:hover {
		text-decoration: underline;
	}
	.mast-links span {
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.plate {
		margin: 2.5rem 0 0;
	}
	.plate img {
		display: block;
		width: 100%;
		aspect-ratio: 21 / 9;
		object-fit: cover;
		object-position: 50% 45%;
	}
	.plate figcaption {
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		padding-top: 0.4rem;
	}
	.census {
		font-family: var(--fd-font-display);
		font-size: clamp(1.35rem, 3vw, 2rem);
		line-height: 1.3;
		margin: 3.5rem 0;
		max-width: 34ch;
		color: var(--sl-color-white);
	}
	.census b {
		font-weight: 400;
		color: var(--sl-color-accent);
	}
	.contents {
		display: grid;
		grid-template-columns: 4fr 7fr;
		gap: 2.5rem;
		align-items: start;
		border-top: 2px solid var(--rule);
		padding-top: 1rem;
	}
	.contents img {
		width: 100%;
		height: auto;
		position: sticky;
		top: calc(var(--sl-nav-height) + 1.5rem);
	}
	h2 {
		font-family: var(--fd-font-display);
		font-weight: 400;
		font-size: var(--sl-text-h2);
		margin: 0 0 0.75rem;
		color: var(--sl-color-white);
	}
	.contents ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.contents li {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		column-gap: 0.5rem;
		padding: 0.8rem 0;
		border-top: 1px solid var(--fd-border);
	}
	.no {
		grid-row: span 2;
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		padding-top: 0.3rem;
	}
	.contents h3 {
		font-family: var(--fd-font-display);
		font-weight: 400;
		font-size: 1.35rem;
		margin: 0;
		color: var(--sl-color-white);
	}
	.contents p {
		margin: 0.2rem 0 0;
		line-height: 1.7;
	}
	.contents a {
		color: var(--sl-color-gray-1);
		text-decoration-color: var(--fd-border);
		text-underline-offset: 0.2em;
	}
	.contents a:hover {
		color: var(--sl-color-accent);
		text-decoration-color: var(--sl-color-accent);
	}
	.sep {
		color: var(--sl-color-gray-4);
	}
	.pantry {
		margin-top: 4rem;
		border-top: 2px solid var(--rule);
		padding-top: 1rem;
	}
	.pantry-note {
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin: 0 0 0.75rem;
	}
	.pantry table {
		width: 100%;
		border-collapse: collapse;
	}
	.pantry tr {
		border-top: 1px solid var(--fd-border);
	}
	.pantry th {
		width: 11rem;
		text-align: left;
		vertical-align: top;
		padding: 0.55rem 1rem 0.55rem 0;
		font-weight: 400;
	}
	.pantry th a {
		display: block;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.pantry th a:hover {
		color: var(--sl-color-accent);
	}
	.pantry th span {
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.pantry td {
		padding: 0.4rem 0;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 2px;
	}
	.colophon {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 1rem;
		margin-top: 4rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--rule);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.colophon p {
		margin: 0;
		max-width: 60ch;
	}
	.lbl {
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 50rem) {
		.mast-cols,
		.contents,
		.colophon {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.contents img {
			position: static;
			max-width: 22rem;
		}
		.plate img {
			aspect-ratio: 4 / 3;
		}
		.pantry th {
			width: 7rem;
		}
	}
</style>
