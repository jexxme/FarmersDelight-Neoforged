---
// Every tag file Farmer's Delight ships (tags.json "files"), grouped by registry, with the file's entries, the
// resolved members from the running game (tags.json "resolved") and what reads the tag.
import fs from 'node:fs';
import Src from '../mc/Src.astro';
import { tags, nameOf, iconOf, pageOf, biomes } from '../../lib/data';
import { tagPurposes, unusedBiomeTags } from '../../data/code/reference-tags';
import { repoPath } from './repo';
import './ref.css';

type F = { registry: string; tag: string; values: string[]; replace: boolean; handWritten?: boolean };
const files = tags.files as F[];
const REG: Record<string, string> = {
	block: 'Block tags',
	item: 'Item tags',
	entity_type: 'Entity type tags',
	worldgen: 'Biome tags',
	enchantment: 'Enchantment tags',
	damage_type: 'Damage type tags',
	villager_trade: 'Villager trade tags',
};
const order = Object.keys(REG);
const resolvedOf = (f: F) => {
	if (f.registry === 'worldgen') {
		const [ns, p] = f.tag.split(':');
		return tags.resolved['worldgen/biome']?.[`${ns}:${p.replace(/^biome\//, '')}`] ?? null;
	}
	return tags.resolved[f.registry]?.[f.tag] ?? null;
};
const pathOf = (f: F) => {
	const [ns, p] = f.tag.split(':');
	const dir = f.registry === 'worldgen' ? `worldgen/${p}` : `${f.registry}/${p}`;
	for (const root of ['src/generated/resources/data', 'src/main/resources/data']) {
		const rel = `${root}/${ns}/tags/${dir}.json`;
		if (fs.existsSync(repoPath(rel))) return rel;
	}
	return null;
};
const label = (reg: string, id: string) => {
	if (reg === 'worldgen') return biomes[id]?.name ?? id.replace(/^minecraft:/, '');
	if (reg === 'item' || reg === 'block') return nameOf(id);
	return id.replace(/^minecraft:/, '');
};
const fdFirst = (a: F, b: F) => Number(!a.tag.startsWith('farmersdelight:')) - Number(!b.tag.startsWith('farmersdelight:')) || a.tag.localeCompare(b.tag);
const groups = order
	.map((reg) => ({ reg, list: files.filter((f) => f.registry === reg).sort(fdFirst) }))
	.filter((g) => g.list.length);
const words = (f: F, members: string[] | null) => [f.tag, ...f.values, ...(members ?? []), ...(members ?? []).map((m) => label(f.registry, m))].join(' ').toLowerCase();
const fdCount = files.filter((f) => f.tag.startsWith('farmersdelight:')).length;
---
<div class="tb not-content" data-tb>
	<div class="ref-bar">
		<input class="ref-field" type="search" placeholder="Search tags and members: knife, onion, c:foods" aria-label="Search tags" data-tb-q />
		<label class="ref-check"><input type="checkbox" data-tb-fd /> Only farmersdelight: tags</label>
		<span class="ref-count"><b data-tb-n>{files.length}</b> of {files.length} tag files</span>
	</div>
	<nav class="ref-btns tb-toc" aria-label="Registries">
		{
			groups.map((g) => (
				<a class="ref-btn" href={`#tags-${g.reg}`}>
					{REG[g.reg]} <span class="n">{g.list.length}</span>
				</a>
			))
		}
	</nav>
	{
		groups.map((g) => (
			<section data-tb-group>
				<h3 id={`tags-${g.reg}`} class="ref-h">
					{REG[g.reg]} <span class="n">{g.list.length}</span>
				</h3>
				<div class="ref-board tb-list">
				{g.list.map((f) => {
					const members = resolvedOf(f);
					const p = tagPurposes[`${f.registry} ${f.tag}`] ?? (f.registry === 'worldgen' && f.tag.startsWith('farmersdelight:') ? unusedBiomeTags : null);
					const file = pathOf(f);
					const fd = f.tag.startsWith('farmersdelight:');
					const visual = f.registry === 'item' || f.registry === 'block';
					return (
						<article class="tb-tag ref-target" data-q={words(f, members)} data-fd={fd ? '1' : '0'} id={`tag-${f.registry}-${f.tag.replace(/[:/]/g, '-')}`}>
							<header>
								<code class="tb-id">#{f.tag}</code>
								<span class={`tb-kind ${fd ? 'own' : ''}`}>{fd ? 'defined here' : 'added to'}</span>
								{p?.unused && <span class="tb-kind warn">unused</span>}
								{f.replace && <span class="tb-kind warn">replace: true</span>}
								{file && <Src path={file} />}
							</header>
							{p ? (
								<p class="tb-what">
									{p.text} {p.uses?.map((u) => <Src path={u.src} lines={u.lines} />)}
								</p>
							) : (
								fd && <p class="tb-what">Groups items so other tags, recipe viewers and add-ons can refer to them.</p>
							)}
							<p class="tb-vals">
								<span class="tb-k">file</span>
								{f.values.map((v) => (
									<code class={v.endsWith('?') ? 'opt' : v.startsWith('#') ? 'ref' : ''} title={v.endsWith('?') ? 'Optional entry: ignored when the mod is not installed' : undefined}>
										{v.replace(/\?$/, '')}
										{v.endsWith('?') && <small> optional</small>}
									</code>
								))}
							</p>
							{members && (
								<div class="tb-mem">
									<span class="tb-k">
										{members.length} {members.length === 1 ? 'member' : 'members'} in game
									</span>
									{visual ? (
										<span class="tb-icons">
											{members.map((m) => {
												const ic = iconOf(m);
												const href = pageOf(m);
												const Tag = href ? 'a' : 'span';
												return (
													<Tag href={href ?? undefined} data-tip-items={`${nameOf(m)}~${m}`} class={ic ? '' : 'txt'}>
														{ic ? <img src={ic.src} alt={nameOf(m)} width="32" height="32" loading="lazy" /> : nameOf(m)}
													</Tag>
												);
											})}
										</span>
									) : (
										<span class="tb-names">{members.map((m) => label(f.registry, m)).join(', ')}</span>
									)}
								</div>
							)}
						</article>
					);
				})}
				</div>
			</section>
		))
	}
	<p data-tb-none hidden class="tb-none">No tag matches.</p>
</div>
<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-tb]')) {
		const q = root.querySelector<HTMLInputElement>('[data-tb-q]')!;
		const fd = root.querySelector<HTMLInputElement>('[data-tb-fd]')!;
		const n = root.querySelector('[data-tb-n]')!;
		const none = root.querySelector<HTMLElement>('[data-tb-none]')!;
		const tagsEls = [...root.querySelectorAll<HTMLElement>('.tb-tag')];
		const groups = [...root.querySelectorAll<HTMLElement>('[data-tb-group]')];
		const apply = () => {
			const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
			let shown = 0;
			for (const t of tagsEls) {
				const ok = (!fd.checked || t.dataset.fd === '1') && words.every((w) => t.dataset.q!.includes(w));
				t.hidden = !ok;
				if (ok) shown++;
			}
			for (const g of groups) g.hidden = !g.querySelector('.tb-tag:not([hidden])');
			n.textContent = String(shown);
			none.hidden = shown > 0;
		};
		q.addEventListener('input', apply);
		fd.addEventListener('change', apply);
	}
</script>
<style>
	.tb-toc {
		margin-top: 10px;
	}
	[data-tb-group][hidden],
	.tb-tag[hidden] {
		display: none;
	}
	.tb-list {
		padding: 0 16px;
	}
	.tb-tag {
		padding: 10px 0;
		border-bottom: 2px solid var(--fd-border);
		display: grid;
		gap: 2px;
		scroll-margin-top: 9rem;
		font-size: 20px;
		line-height: 30px;
	}
	.tb-tag:last-child {
		border-bottom: 0;
	}
	.tb-tag header {
		display: flex;
		flex-wrap: wrap;
		gap: 0 16px;
		align-items: center;
	}
	.tb-id {
		font-family: var(--sl-font);
		font-size: 20px;
		color: var(--fd-heading-ink);
		background: none;
		padding: 0;
		overflow-wrap: anywhere;
	}
	.tb-kind {
		color: var(--sl-color-gray-3);
	}
	.tb-kind.own {
		color: var(--fd-green);
	}
	.tb-kind.warn {
		color: var(--fd-gold);
	}
	.tb-tag p {
		margin: 0;
	}
	.tb-what {
		color: var(--sl-color-gray-2);
	}
	.tb-vals,
	.tb-mem {
		display: flex;
		flex-wrap: wrap;
		gap: 0 12px;
		align-items: center;
	}
	.tb-k {
		min-width: 9rem;
		color: var(--sl-color-gray-4);
	}
	.tb-vals code {
		font-family: var(--sl-font);
		font-size: 20px;
		background: none;
		padding: 0;
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
	.tb-vals code.ref {
		color: var(--sl-color-text-accent);
	}
	.tb-vals code.opt {
		color: var(--sl-color-gray-3);
	}
	.tb-vals small {
		font-size: 20px;
		color: var(--sl-color-gray-4);
	}
	.tb-icons {
		display: flex;
		flex-wrap: wrap;
		gap: 2px;
		flex: 1 1 0;
		min-width: 12rem;
		padding: 2px 0;
	}
	.tb-icons > * {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		background: #8b8b8b;
		box-shadow: inset 2px 2px 0 #373737, inset -2px -2px 0 #fff;
	}
	.tb-icons img {
		image-rendering: pixelated;
		display: block;
		width: 32px;
		height: 32px;
	}
	.tb-icons a:hover {
		background: #c5c5c5;
	}
	.tb-icons .txt {
		width: auto;
		padding: 0 8px;
		color: #fff;
		text-shadow: 2px 2px 0 #3f3f3f;
	}
	.tb-names {
		color: var(--sl-color-gray-2);
		flex: 1 1 0;
		min-width: 12rem;
	}
	.tb-none {
		color: var(--sl-color-gray-3);
	}
</style>
