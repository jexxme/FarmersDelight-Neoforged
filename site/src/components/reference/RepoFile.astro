---
// Shows a real file from the mod's repository (read at build time), with its path as the title and a source link.
// <RepoFile path="src/generated/resources/data/farmersdelight/recipe/cooking/beef_stew.json" />
import fs from 'node:fs';
import { Code } from '@astrojs/starlight/components';
import Src from '../mc/Src.astro';
import { repoPath } from './repo';
interface Props {
	path: string;
	lang?: string;
	title?: string;
	/** Only show these lines (1-based, inclusive), e.g. "1-20". */
	lines?: string;
	mark?: string[];
}
const { path, lang, title, lines, mark } = Astro.props;
let code = fs.readFileSync(repoPath(path), 'utf8').replace(/\r\n/g, '\n').replace(/\n$/, '');
if (lines) {
	const [a, b] = lines.split('-').map(Number);
	code = code.split('\n').slice(a - 1, b ?? a).join('\n');
}
const ext = path.split('.').pop();
---
<div class="fd-repofile">
	<Code code={code} lang={lang ?? (ext === 'json' ? 'json' : ext === 'toml' ? 'toml' : ext === 'java' ? 'java' : 'text')} title={title ?? path.replace(/^src\/(generated|main)\/resources\//, '')} mark={mark} />
	<div class="fd-repofile-src"><Src path={path} lines={lines} label={`${path.split('/').pop()}${lines ? `:${lines}` : ''} on GitHub`} /></div>
</div>
<style>
	.fd-repofile {
		margin: 20px 0 24px;
	}
	.fd-repofile-src {
		display: flex;
		justify-content: flex-end;
		margin-top: 6px;
	}
</style>
