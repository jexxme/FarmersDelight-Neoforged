---
// "Best food" callouts plus the sortable food table (islands/ref-food.tsx). All values come from items.json,
// vanilla-foods.json and soup-effects.json.
import FoodTable from '../islands/ref-food';
import { foodRows, categoryLabels, best } from './food';
import { duration, url } from '../../lib/data';
import './ref.css';
import type { FoodRow } from '../islands/ref-food';

const rows = foodRows();
const fd = rows.filter((r) => !r.vanilla && r.nutrition > 0);
const maxS = Math.max(...rows.map((r) => r.saturation));
const fastest = Math.min(...fd.map((r) => r.seconds));
const quick = fd.filter((r) => r.seconds === fastest);
const counts = new Map<number, number>();
for (const r of fd) counts.set(r.seconds, (counts.get(r.seconds) ?? 0) + 1);
const normal = [...counts].sort((a, b) => b[1] - a[1])[0][0];
const mealStack = Math.max(...fd.filter((r) => r.category === 'meals').map((r) => r.stack));
const callouts: { title: string; value: string; note: string; rows: FoodRow[] }[] = [
	(() => {
		const b = best(fd, (r) => r.saturation);
		const n = b.rows[0].nutrition;
		return { title: 'Most filling', value: `${+b.value.toFixed(1)} saturation`, note: `${b.rows.length} foods tie, all with ${n} hunger; ${b.rows.filter((r) => r.nourishment > 0).length} of them also give Nourishment.`, rows: b.rows };
	})(),
	(() => {
		const b = best(fd, (r) => r.nutrition * r.stack);
		const r = b.rows[0];
		return { title: 'Most hunger per stack', value: `${b.value} hunger`, note: `${r.nutrition} per item × stacks of ${r.stack}. Bowl meals stack to ${mealStack}, so handheld food wins on inventory space.`, rows: b.rows };
	})(),
	(() => {
		const b = best(fd, (r) => r.saturation * r.stack);
		const r = b.rows[0];
		return { title: 'Most saturation per stack', value: `${+b.value.toFixed(1)} saturation`, note: `${+r.saturation.toFixed(1)} per item × ${r.stack}.`, rows: b.rows };
	})(),
	(() => {
		const b = best(rows.filter((r) => !r.vanilla), (r) => r.nourishment);
		return { title: 'Longest Nourishment', value: duration(b.value), note: `${b.rows.length} foods give the longest Nourishment, so the hunger bar stops draining for ${duration(b.value)} minutes (except while healing).`, rows: b.rows };
	})(),
	(() => {
		const b = best(quick, (r) => r.nutrition);
		return { title: 'Best quick bite', value: `${b.value} hunger in ${fastest} s`, note: `Highest hunger among the ${quick.length} foods you eat in ${fastest} s (most foods take ${normal} s).`, rows: b.rows };
	})(),
];
---
<dl class="fd-best ref-board not-content">
	{
		callouts.map((c) => (
			<div class="row">
				<dt>{c.title}</dt>
				<dd>
					<span class="val">{c.value}</span>
					<span class="icons">
						{c.rows.slice(0, 12).map((r) => (
							<a href={r.href ?? undefined} data-tip-items={`${r.name}~${r.id}`}>
								{r.icon && <img class="ref-icon" src={r.icon} alt={r.name} width="32" height="32" loading="lazy" />}
							</a>
						))}
						{c.rows.length > 12 && <span class="more">+{c.rows.length - 12}</span>}
					</span>
					<span class="note">
						{c.rows.length <= 3 && <strong>{c.rows.map((r) => r.name).join(', ')}. </strong>}
						{c.note}
					</span>
				</dd>
			</div>
		))
	}
</dl>
<FoodTable client:visible rows={rows} cats={categoryLabels} maxS={maxS} shank={{ full: url('/gui/mc/food_full.png'), half: url('/gui/mc/food_half.png') }} />
<style>
	.fd-best {
		margin: 20px 0 30px;
		padding: 0 16px;
	}
	.row {
		display: grid;
		grid-template-columns: 15rem 1fr;
		gap: 4px 20px;
		padding: 10px 0;
		border-bottom: 2px solid var(--fd-border);
	}
	.row:last-child {
		border-bottom: 0;
	}
	dt {
		font-size: 20px;
		line-height: 30px;
		color: var(--sl-color-text-accent);
	}
	dd {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 16px;
	}
	.val {
		font-size: 20px;
		line-height: 30px;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.icons {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 2px;
		align-items: center;
	}
	.icons a:hover img {
		outline: 2px solid #fff;
	}
	.more {
		font-size: 20px;
		color: var(--sl-color-gray-3);
		margin-left: 4px;
	}
	.note {
		flex-basis: 100%;
		font-size: 20px;
		line-height: 30px;
		color: var(--sl-color-gray-3);
	}
	.note strong {
		color: var(--sl-color-gray-2);
	}
	@media (max-width: 40rem) {
		.row {
			grid-template-columns: 1fr;
		}
	}
</style>
