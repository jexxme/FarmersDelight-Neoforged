---
// Both config files from config.json (read from Configuration.java by extract.mjs), grouped by file and section,
// with the definition line in Configuration.java and a note on what each option changes.
import { Code } from '@astrojs/starlight/components';
import Src from '../mc/Src.astro';
import { config, url } from '../../lib/data';
import { configNotes } from '../../data/code/reference-config';
import { readRepo, JAVA } from './repo';
import './ref.css';
interface Props {
	file?: string;
	toml?: boolean;
}
const { file, toml = false } = Astro.props;
const javaPath = 'common/Configuration.java';
const java = readRepo(JAVA + javaPath).split('\n');
/** Lines of the option's definition: from its "X = BUILDER.comment(" line to the define(...) line. */
function linesOf(key: string) {
	const def = java.findIndex((l) => new RegExp(`\\.define\\w*\\("${key}"`).test(l));
	if (def < 0) return null;
	let startLine = def;
	while (startLine > 0 && !/=\s*\w+_BUILDER/.test(java[startLine])) startLine--;
	return `${startLine + 1}-${def + 1}`;
}
const files = [...new Set(config.map((c) => c.file))].filter((f) => !file || f === file);
const fmt = (v: unknown): string => (Array.isArray(v) ? `[${v.map(fmt).join(', ')}]` : typeof v === 'string' ? `"${v}"` : String(v));
const typeName: Record<string, string> = { boolean: 'true / false', decimal: 'decimal', list: 'list of strings', string: 'string', integer: 'integer' };
function tomlOf(f: string) {
	const out: string[] = [];
	let section: string | null = null;
	for (const c of config.filter((x) => x.file === f)) {
		if (c.section !== section) {
			section = c.section;
			if (section) out.push((out.length ? '\n' : '') + `[${section}]`);
		}
		const ind = section ? '\t' : '';
		for (const line of c.comment) out.push(`${ind}# ${line}`);
		out.push(`${ind}${c.key} = ${fmt(c.default)}`);
	}
	return out.join('\n');
}
---
{
	toml
		? files.map((f) => <Code code={tomlOf(f)} lang="toml" title={`${f} (defaults)`} />)
		: files.map((f) => {
				const rows = config.filter((c) => c.file === f);
				const sections = [...new Set(rows.map((c) => c.section))];
				return (
					<div class="cfg not-content">
						{sections.map((s) => (
							<section>
								<h3 class="ref-h" id={`${f.replace('.toml', '')}-${s || 'root'}`}>
									{s ? `[${s}]` : 'Top level'}
								</h3>
								<dl class="ref-board">
									{rows
										.filter((c) => c.section === s)
										.map((c) => {
											const n = configNotes[c.key];
											const lines = linesOf(c.key);
											return (
												<div class="cfg-row ref-target" id={c.key}>
													<dt>
														<a href={`#${c.key}`} class="cfg-key">
															{c.key}
														</a>
														<span class="cfg-type">{typeName[c.type] ?? c.type}</span>
													</dt>
													<dd>
														<div class="cfg-vals">
															<span>
																<i>default</i> <code>{fmt(c.default)}</code>
															</span>
															{c.range && (
																<span>
																	<i>range</i> <code>{c.range[0]}</code>–<code>{c.range[1]}</code>
																</span>
															)}
															{lines && <Src path={javaPath} lines={lines} />}
														</div>
														<p class="cfg-comment">{c.comment.join(' ')}</p>
														{n && (
															<details class="ref-details">
																<summary>What it affects</summary>
																<p>
																	{n.text} {n.link && <a href={url(n.link)}>More</a>}
																</p>
																<p class="cfg-uses">
																	Read in {n.uses.map((u) => <Src path={u.src} lines={u.lines} />)}
																</p>
															</details>
														)}
													</dd>
												</div>
											);
										})}
								</dl>
							</section>
						))}
					</div>
				);
			})
}
<style>
	.cfg {
		margin: 10px 0 30px;
	}
	dl {
		margin: 0;
		padding: 0 16px;
	}
	.cfg-row {
		display: grid;
		grid-template-columns: minmax(14rem, 20rem) 1fr;
		gap: 4px 24px;
		padding: 12px 0;
		border-bottom: 2px solid var(--fd-border);
		scroll-margin-top: 6rem;
	}
	.cfg-row:last-child {
		border-bottom: 0;
	}
	dt {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 30px;
	}
	.cfg-key {
		font-size: 20px;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.cfg-key:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.cfg-type {
		font-size: 20px;
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0;
		min-width: 0;
		line-height: 30px;
	}
	.cfg-vals {
		display: flex;
		flex-wrap: wrap;
		gap: 0 20px;
		align-items: center;
		font-size: 20px;
	}
	.cfg-vals i {
		font-style: normal;
		color: var(--sl-color-gray-3);
	}
	.cfg-vals code {
		font-family: var(--sl-font);
		font-size: 20px;
		color: var(--sl-color-white);
		background: var(--sl-color-black);
		padding: 0 6px;
		overflow-wrap: anywhere;
	}
	.cfg-comment {
		margin: 6px 0 0;
		font-size: 20px;
		color: var(--sl-color-gray-2);
	}
	details {
		margin-top: 6px;
	}
	details p {
		margin: 6px 0 0;
		font-size: 20px;
		color: var(--sl-color-gray-2);
	}
	details a {
		color: var(--sl-color-text-accent);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.cfg-uses {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
		color: var(--sl-color-gray-3) !important;
	}
	@media (max-width: 45rem) {
		.cfg-row {
			grid-template-columns: 1fr;
		}
	}
</style>
