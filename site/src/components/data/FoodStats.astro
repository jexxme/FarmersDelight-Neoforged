---
// Hunger shanks (from the vanilla HUD sprites) plus a saturation gauge, for one food.
import { url } from '../../lib/data';
interface Props {
	nutrition: number;
	saturation: number;
	compact?: boolean;
}
const { nutrition, saturation, compact = false } = Astro.props;
const full = Math.floor(nutrition / 2);
const half = nutrition % 2;
const icons = [...Array(full).fill('food_full'), ...Array(half).fill('food_half')];
const satPct = Math.min(100, (saturation / 20) * 100);
---
<div class:list={['fd-food', { compact }]}>
	<div class="shanks" role="img" aria-label={`${nutrition} hunger points`} title={`${nutrition} hunger points (${nutrition / 2} shanks)`}>
		{icons.map((i) => <img src={url(`/gui/mc/${i}.png`)} alt="" width="18" height="18" />)}
		<span class="n">{nutrition}</span>
	</div>
	<div class="sat" title={`${+saturation.toFixed(2)} saturation (maximum 20)`}>
		<span class="bar"><span style={`width:${satPct}%`}></span></span>
		<span class="n">{+saturation.toFixed(2)} <small>sat.</small></span>
	</div>
</div>
<style>
	.fd-food {
		display: inline-flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	.shanks {
		display: flex;
		align-items: center;
		gap: 1px;
		flex-wrap: wrap;
	}
	.shanks img {
		image-rendering: pixelated;
		width: 18px;
		height: 18px;
	}
	.compact .shanks img {
		width: 14px;
		height: 14px;
	}
	.n {
		margin-left: 0.4rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
	}
	.n small {
		color: var(--sl-color-gray-3);
		font-weight: 450;
	}
	.sat {
		display: flex;
		align-items: center;
	}
	.bar {
		width: 9rem;
		height: 0.5rem;
		border-radius: 1rem;
		background: var(--fd-surface-2);
		border: 1px solid var(--fd-border);
		overflow: hidden;
	}
	.compact .bar {
		width: 5rem;
	}
	.bar span {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, #f3b300, #ffd34d);
		border-radius: 1rem;
	}
</style>
