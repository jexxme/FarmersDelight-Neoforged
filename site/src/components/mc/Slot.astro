---
// A Minecraft inventory slot. Shows one item, or cycles through every item of a tag/ingredient (like JEI).
import { nameOf, iconOf, pageOf, short, type Ingredient } from '../../lib/data';
interface Props {
	id?: string;
	ingredient?: Ingredient | null;
	count?: number;
	chance?: number;
	scale?: number;
	large?: boolean;
	bare?: boolean;
	note?: string;
}
const { id, ingredient, count = 1, chance, scale = 2, large = false, bare = false, note } = Astro.props;
// A slot cycles through at most 12 of an ingredient's items (the tooltip names the whole tag) to keep pages light
const all = ingredient ? [...new Set(ingredient.items)] : id ? [id] : [];
const list = all.slice(0, 12);
const tagLine = ingredient?.tag
	? `Any #${short(ingredient.tag)}`
	: ingredient?.action
		? `Any tool that can ${ingredient.action.replaceAll('_', ' ')}`
		: ingredient && all.length > 1
			? `Any of ${all.length} items`
			: '';
const first = list[0];
const link = list.length === 1 && first ? pageOf(first) : null;
const Tag = link ? 'a' : 'div';
const sub = [tagLine, chance !== undefined && chance < 1 ? `${+(chance * 100).toFixed(1)}% chance` : '', note ?? ''].filter(Boolean).join(' · ');
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACw=';
---
<Tag
	class:list={['mc-slot', { large, bare }]}
	style={`--s:${scale}px`}
	href={link ?? undefined}
	tabindex={link ? undefined : list.length ? 0 : undefined}
	data-tip-items={list.length ? list.map((i) => `${nameOf(i)}~${i}`).join('|') : undefined}
	data-tip-sub={sub || undefined}
>
	{
		list.length > 0 && (
			<span class:list={['mc-stack', { 'mc-cycle': list.length > 1 }]}>
				{list.map((i, n) => {
					const ic = iconOf(i);
					return <img src={ic?.src ?? blank} alt={n === 0 ? nameOf(i) : ''} class:list={[{ on: n === 0 }]} loading="lazy" width="32" height="32" />;
				})}
				{count > 1 && <span class="mc-count">{count}</span>}
				{chance !== undefined && chance < 1 && <span class="mc-chance">{Math.round(chance * 100)}%</span>}
			</span>
		)
	}
</Tag>
