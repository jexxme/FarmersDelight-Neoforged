---
// Organic Compost calculator (island) with its constants from data/code/farming.ts and the source citations.
import CompostCalc from '../islands/farming-compost';
import Src from '../mc/Src.astro';
import Vanilla from './Vanilla.astro';
import { compost, vanilla, cite } from '../../data/code/farming';
const k = {
	activator: compost.activator.value,
	bright: compost.skyBright.value,
	dim: compost.skyDim.value,
	water: compost.waterAdd.value,
	threshold: compost.skyThreshold.value,
	successes: compost.stages.value + 1,
	cube: (2 * compost.cube.value + 1) ** 3,
	tickSpeed: vanilla.randomTickSpeed.value,
	section: vanilla.sectionTick.value,
};
---
<figure class="fdc-wrap">
	<CompostCalc client:visible k={k} />
	<figcaption>
		Chance: <Src {...cite(compost.activator)} /> <Src {...cite(compost.skyThreshold)} /> <Src {...cite(compost.waterAdd)} /> <Src {...cite(compost.roll)} />. Timing:
		<Vanilla {...cite(vanilla.randomTickSpeed)} /> <Vanilla {...cite(vanilla.sectionTick)} />. Times are averages at 20 ticks per second; a single compost block can be much faster or slower.
	</figcaption>
</figure>
<style is:global>
	.fdc-wrap {
		margin: 30px 0;
	}
	.fdc-wrap figcaption {
		font-size: 20px;
		line-height: 30px;
		color: var(--sl-color-gray-3);
		margin-top: 14px;
	}
	.fdc {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		background: var(--fd-surface);
		border: 3px solid var(--fd-frame);
		box-shadow: var(--fd-shadow);
		font-size: 20px;
		line-height: 26px;
	}
	@media (max-width: 50rem) {
		.fdc {
			grid-template-columns: 1fr;
		}
		.fdc-in {
			border-right: 0 !important;
			border-bottom: 3px solid var(--fd-frame);
		}
	}
	.fdc-in {
		padding: 14px 16px;
		border-right: 3px solid var(--fd-frame);
		display: flex;
		flex-direction: column;
		gap: 16px;
		color: var(--sl-color-gray-2);
	}
	.fdc-row {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		cursor: pointer;
	}
	.fdc-row input {
		margin-top: 4px;
		width: 18px;
		height: 18px;
		accent-color: var(--fd-orange);
	}
	.fdc-col {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.fdc-col b {
		color: var(--fd-gold);
	}
	.fdc-col small {
		font-size: 20px;
		color: var(--sl-color-gray-3);
	}
	.fdc-col input[type='range'] {
		accent-color: var(--fd-orange);
		width: 100%;
	}
	.fdc-out {
		padding: 14px 16px;
	}
	.fdc-big {
		display: flex;
		flex-direction: column;
	}
	.fdc-k,
	.fdc dt {
		color: var(--sl-color-gray-3);
	}
	.fdc-v {
		font-size: 40px;
		line-height: 50px;
		color: var(--fd-gold);
	}
	.fdc-bar {
		display: flex;
		height: 14px;
		margin: 8px 0;
		background: var(--sl-color-gray-6);
		box-shadow: inset 2px 2px 0 #000;
	}
	.fdc-bar .s,
	.fdc-legend i {
		display: block;
	}
	.fdc .s0 {
		background: var(--fd-green);
	}
	.fdc .s1 {
		background: var(--fd-gold);
	}
	.fdc .s2 {
		background: #3f76e4;
	}
	.fdc-legend {
		list-style: none;
		padding: 0;
		margin: 0 0 10px;
		display: flex;
		flex-wrap: wrap;
		gap: 0 20px;
		color: var(--sl-color-gray-2);
	}
	.fdc-legend li {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.fdc-legend i {
		width: 10px;
		height: 10px;
		box-shadow: 2px 2px 0 #000;
	}
	.fdc dl {
		display: grid;
		grid-template-columns: 1fr auto;
		margin: 0;
	}
	.fdc dt,
	.fdc dd {
		margin: 0;
		padding: 4px 0;
		border-top: 2px solid var(--fd-border);
	}
	.fdc dd {
		text-align: right;
		color: var(--sl-color-white);
	}
	.fdc .fdc-hl {
		color: var(--fd-gold);
		text-shadow: var(--fd-px) 0 0 currentColor;
		letter-spacing: var(--fd-px);
	}
</style>
