---
// A wrap of small item/block chips (icon when one exists, else just the name). For resolved tag contents and lists.
// <Chips ids={tags.resolved.block['minecraft:substrate_overworld']} />   or   <Chips tag="minecraft:substrate_overworld" />
// Shows block and item names only; the ids stay out of the page.
import { tags, nameOf, iconOf, pageOf } from '../../lib/data';
interface Props {
	ids?: string[];
	tag?: string;
	registry?: 'block' | 'item';
	label?: string;
	compact?: boolean;
}
const { ids, tag, registry = 'block', label, compact = false } = Astro.props;
const list = ids ?? (tag ? (tags.resolved[registry]?.[tag] ?? []) : []);
const title = (id: string) => {
	const n = nameOf(id);
	return n === id.split(':')[1].replaceAll('_', ' ') ? n.replace(/\b\w/g, (c) => c.toUpperCase()) : n;
};
---
<span class:list={['fd-chips', 'not-content', { compact }]}>
	{label && <span class="lbl">{label}</span>}
	{
		list.map((id) => {
			const ic = iconOf(id);
			const href = pageOf(id);
			const Tag = href ? 'a' : 'span';
			return (
				<Tag class="chip" href={href ?? undefined}>
					{ic && <img src={ic.src} alt="" width="20" height="20" loading="lazy" />}
					{title(id)}
				</Tag>
			);
		})
	}
</span>
<style>
	.fd-chips {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 6px;
		vertical-align: middle;
	}
	.lbl {
		font-family: var(--fd-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		align-self: center;
		margin-right: 0.2rem;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0 8px;
		border-radius: 0;
		background: var(--fd-surface);
		border: 2px solid var(--fd-border);
		font-size: var(--sl-text-xs);
		line-height: 28px;
		color: var(--sl-color-gray-1);
		text-decoration: none;
		white-space: nowrap;
	}
	a.chip:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.chip img {
		image-rendering: pixelated;
		width: 20px;
		height: 20px;
	}
	.compact .chip {
		padding: 0 0.4rem;
	}
</style>
