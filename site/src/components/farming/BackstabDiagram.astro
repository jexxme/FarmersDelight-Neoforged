---
// Top-down view of the Backstabbing angle rule: the hit counts when dot(attacker direction, target look) < threshold.
import { knife } from '../../data/code/farming';
const t = knife.backstabAngle.value; // -0.5
const behind = (Math.acos(t) * 180) / Math.PI; // angle from the look direction where the zone starts (120°)
const half = Math.round(180 - behind); // half-width of the zone around "directly behind" (60°)
const R = 120;
const cx = 200;
const cy = 150;
const rad = (d: number) => (d * Math.PI) / 180;
// target looks up (-y). "Behind" is +y. Zone spans behind ± half.
const p = (deg: number, r = R) => [cx + r * Math.sin(rad(deg)), cy - r * Math.cos(rad(deg))]; // deg from look direction, clockwise
const [ax, ay] = p(behind);
const [bx, by] = p(360 - behind);
const zone = `M ${cx} ${cy} L ${ax} ${ay} A ${R} ${R} 0 0 1 ${bx} ${by} Z`;
const [hx, hy] = p(180 + 25, 95);
const [mx, my] = p(60, 95);
---
<figure class="fd-bs fd-board not-content">
	<svg viewBox="0 0 400 290" role="img" aria-label={`Backstabbing counts when the attacker stands within ${half} degrees of directly behind the target`}>
		<circle cx={cx} cy={cy} r={R} class="ring" />
		<path d={zone} class="zone" />
		<line x1={cx} y1={cy} x2={cx} y2={cy - R - 8} class="look" marker-end="url(#fdbs-arrow)" />
		<defs>
			<marker id="fdbs-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="head" />
			</marker>
		</defs>
		<rect x={cx - 9} y={cy - 9} width="18" height="18" class="target" />
		<text x={cx + 10} y={cy - R + 12} class="lbl">looking</text>
		<line x1={cx} y1={cy} x2={ax} y2={ay} class="edge" />
		<line x1={cx} y1={cy} x2={bx} y2={by} class="edge" />
		<text x={ax + 8} y={ay + 8} class="lbl">{Math.round(behind)}°</text>
		<rect x={hx - 7} y={hy - 7} width="14" height="14" class="hit" />
		<text x={hx + 12} y={hy + 7} class="lbl">bonus</text>
		<rect x={mx - 7} y={my - 7} width="14" height="14" class="miss" />
		<text x={mx + 12} y={my + 7} class="lbl dim">no bonus</text>
	</svg>
	<figcaption>Seen from above: the {half * 2}° zone behind the target, both at the same height and the target looking straight ahead. A height difference or the target looking up or down shrinks the zone.</figcaption>
</figure>
<style>
	.fd-bs {
		margin: 1.25rem 0;
		max-width: 25rem;
		padding: 12px 16px;
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.ring {
		fill: none;
		stroke: var(--fd-border);
	}
	.zone {
		fill: var(--fd-orange-paper);
		opacity: 0.35;
		stroke: none;
	}
	.edge {
		stroke: var(--sl-color-accent);
		stroke-dasharray: 3 3;
	}
	.look {
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.head {
		fill: var(--sl-color-white);
	}
	.target {
		fill: var(--sl-color-white);
	}
	.hit {
		fill: var(--sl-color-accent);
	}
	.miss {
		fill: none;
		stroke: var(--sl-color-gray-3);
	}
	.lbl {
		font-family: var(--fd-font-mono);
		font-size: 20px;
		fill: var(--sl-color-gray-2);
	}
	.mid {
		text-anchor: middle;
	}
	.dim {
		fill: var(--sl-color-gray-3);
	}
	figcaption {
		font-size: 20px;
		line-height: 28px;
		color: var(--sl-color-gray-3);
	}
</style>
