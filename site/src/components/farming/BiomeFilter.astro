---
// Wrapper for the biome filter island: builds its props from the generated data and carries its styles.
import BiomeFilter from '../islands/farming-biomes';
import { iconOf } from '../../lib/data';
import { biomeFilterData } from '../../data/code/farming-world';
const data = biomeFilterData((id) => iconOf(id)?.src ?? null);
---
<BiomeFilter client:visible biomes={data.biomes} plants={data.plants} />
<style is:global>
	.fdb {
		display: grid;
		grid-template-columns: 16rem 1fr;
		background: var(--fd-surface);
		border: 3px solid var(--fd-frame);
		box-shadow: var(--fd-shadow);
		margin: 30px 0;
		min-height: 22rem;
		font-size: 20px;
		line-height: 26px;
	}
	@media (max-width: 50rem) {
		.fdb {
			grid-template-columns: 1fr;
		}
		.fdb-side {
			border-right: 0 !important;
			border-bottom: 3px solid var(--fd-frame);
		}
		.fdb-side ul {
			max-height: 13rem;
		}
	}
	.fdb-side {
		border-right: 3px solid var(--fd-frame);
		display: flex;
		flex-direction: column;
		min-height: 0;
	}
	.fdb-side input {
		font: inherit;
		font-size: 20px;
		padding: 6px 8px;
		border: 2px solid #a0a0a0;
		margin: 8px;
		background: #000;
		color: #e0e0e0;
		border-radius: 0;
	}
	.fdb-side ul {
		list-style: none;
		margin: 0;
		padding: 0 0 8px;
		overflow-y: auto;
		max-height: 24rem;
	}
	.fdb-side li {
		margin: 0;
	}
	.fdb-side button {
		all: unset;
		box-sizing: border-box;
		width: 100%;
		display: flex;
		justify-content: space-between;
		padding: 2px 10px;
		font-size: 20px;
		line-height: 26px;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.fdb-side button:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.fdb-side button.on {
		background: var(--fd-orange-paper);
		color: var(--fd-orange-ink);
		box-shadow: inset 0 0 0 2px var(--fd-orange-frame);
	}
	.fdb-side button:focus-visible {
		outline: 2px solid var(--fd-gold);
		outline-offset: -2px;
	}
	.fdb-side .c {
		color: inherit;
	}
	.fdb-main {
		padding: 12px 16px;
	}
	.fdb-h {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 16px;
		border-bottom: 2px solid var(--fd-border);
		padding-bottom: 6px;
		margin-bottom: 8px;
	}
	.fdb-name {
		font-size: 30px;
		line-height: 40px;
		color: var(--fd-heading-ink);
	}
	.fdb-t,
	.fdb .m {
		color: var(--sl-color-gray-3);
	}
	.fdb table {
		width: 100%;
		border-collapse: collapse;
	}
	.fdb th {
		text-align: left;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		border-bottom: 2px solid var(--fd-border);
		padding: 4px 10px 4px 0;
	}
	.fdb td {
		padding: 4px 10px 4px 0;
		border-bottom: 2px solid var(--fd-border);
	}
	.fdb td a {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.fdb td a:hover {
		color: var(--sl-color-text-accent);
	}
	.fdb td img {
		image-rendering: pixelated;
		width: 32px;
		height: 32px;
	}
	.fdb-none {
		color: var(--sl-color-gray-3);
	}
	.fdb-foot {
		margin-top: 12px;
		color: var(--sl-color-gray-3);
	}
</style>
