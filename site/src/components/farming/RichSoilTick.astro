---
// What Rich Soil does each time it gets a turn, as three ordered cases.
import { renderOf, config, pct } from '../../lib/data';
const boost = config.find((c) => c.key === 'richSoilBoostChance').default as number;
const steps = [
	{ img: 'stages/brown_mushroom_colony-0', head: 'Mushroom above', text: 'A brown or red mushroom on top turns into a mushroom colony. Every time, in any light.' },
	{ img: 'stages/cabbages-4', head: 'Plant above', text: `Otherwise, ${pct(boost, 0)} of the time: a free bone meal for the plant on top, if bone meal would work on it right now.` },
	{ img: 'blocks/rich_soil', head: 'Plant below', text: 'If nothing on top got it: the same free bone meal goes to cave vines hanging underneath.' },
];
---
<figure class="fd-rst not-content">
	<ol class="fd-board">
		{
			steps.map((s, i) => (
				<li>
					<span class="n">{i + 1}</span>
					<img src={renderOf(s.img)} alt="" width="72" height="72" loading="lazy" />
					<span class="h">{s.head}</span>
					<span class="t">{s.text}</span>
				</li>
			))
		}
	</ol>
</figure>
<style>
	.fd-rst {
		margin: 1.5rem 0;
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 50rem) {
		ol {
			grid-template-columns: 1fr;
		}
		li + li {
			border-left: 0 !important;
			border-top: 3px solid var(--fd-frame);
		}
	}
	li {
		margin: 0 !important;
		padding: 12px 14px;
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto 1fr;
		column-gap: 10px;
		align-items: start;
	}
	li + li {
		border-left: 3px solid var(--fd-frame);
	}
	.n {
		font-family: var(--fd-font-mono);
		font-size: 30px;
		line-height: 30px;
		color: var(--fd-gold);
		grid-row: 1 / 3;
	}
	img {
		grid-column: 2;
		width: 72px;
		height: auto;
		image-rendering: pixelated;
	}
	.h {
		grid-column: 2;
		color: var(--fd-heading-ink);
		text-shadow: var(--fd-px) 0 0 currentColor;
		letter-spacing: var(--fd-px);
	}
	.t {
		grid-column: 1 / 3;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		margin-top: 6px;
		line-height: 26px;
	}
</style>
