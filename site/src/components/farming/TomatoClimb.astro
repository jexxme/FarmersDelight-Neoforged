---
// Side view of a tomato vine climbing a rope column: the base crop plus at most `limit` rope segments (TomatoBlock.climbRopeAbove).
import { crops } from '../../data/code/farming';
const limit = crops.tomatoClimb.value; // loop stops when vineHeight reaches this; base + (limit) segments
const segments = limit; // derived: base crop (height 1) + segments while the count below stays < limit
const ropes = segments + 1; // one extra rope that stays bare
const B = 40; // block size in the drawing
const W = 560;
const H = (ropes + 2) * B + 50;
const ground = H - 30 - B;
const col = (x: number, label: string, top: number) => ({ x, label, top });
const X3 = 360;
const cols = [col(40, 'planted', 0), col(200, 'on rope', 0), col(X3, 'climbed', segments)];
---
<figure class="fd-climb fd-board not-content">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`A tomato vine climbs up to ${segments} rope blocks above the base crop`}>
		<line x1="10" x2={W - 10} y1={ground + B} y2={ground + B} class="rule" />
		{
			cols.map((c, ci) => (
				<g>
					<rect x={c.x} y={ground} width={B} height={B} class="soil" />
					<text x={c.x + B / 2} y={ground + B + 26} class="lbl">{c.label}</text>
					{ci > 0 &&
						Array.from({ length: ropes }, (_, i) => {
							const y = ground - (i + 2) * B;
							const vine = i < c.top;
							return (
								<g>
									<line x1={c.x + B / 2} x2={c.x + B / 2} y1={y} y2={y + B} class={vine ? 'rope on' : 'rope'} />
									{vine && <rect x={c.x + 7} y={y + 4} width={B - 14} height={B - 8} class="leaf" />}
									{vine && <circle cx={c.x + B / 2 + 6} cy={y + B / 2} r="5" class="fruit" />}
								</g>
							);
						})}
					<rect x={c.x + 4} y={ground - B + (ci === 0 ? B / 2 : 4)} width={B - 8} height={ci === 0 ? B / 2 : B - 4} class="leaf" />
					{ci > 0 && <circle cx={c.x + B / 2 + 6} cy={ground - B / 2} r="4" class="fruit" />}
				</g>
			))
		}
		<g class="brace">
			<line x1={X3 + B + 12} x2={X3 + B + 12} y1={ground - (segments + 1) * B} y2={ground - B} />
			<text x={X3 + B + 22} y={ground - B - (segments * B) / 2 + 7} class="note">{segments} ropes</text>
			<text x={X3 + B + 22} y={ground - (segments + 1.5) * B + 7} class="note dim">stays rope</text>
		</g>
	</svg>
	<figcaption>The base crop counts as height 1; each random tick (light {crops.tomatoTick.value}+) the top vine tries to grow onto the rope above until {segments} rope blocks are covered.</figcaption>
</figure>
<style>
	.fd-climb {
		margin: 30px 0;
		padding: 12px 16px;
		max-width: 35rem;
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.rule {
		stroke: var(--fd-border);
	}
	.soil {
		fill: none;
		stroke: var(--sl-color-gray-4);
	}
	.rope {
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
		stroke-dasharray: 2 3;
	}
	.rope.on {
		stroke-dasharray: none;
	}
	.leaf {
		fill: var(--fd-green);
		opacity: 0.85;
	}
	.fruit {
		fill: var(--sl-color-accent);
	}
	.lbl,
	.note {
		font-family: var(--fd-font-mono);
		font-size: 20px;
		fill: var(--sl-color-gray-2);
	}
	.lbl {
		text-anchor: middle;
	}
	.dim {
		fill: var(--sl-color-gray-3);
	}
	.brace line {
		stroke: var(--sl-color-gray-3);
	}
	figcaption {
		font-size: 20px;
		line-height: 30px;
		color: var(--sl-color-gray-3);
	}
</style>
